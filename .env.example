# ─── Supabase ────────────────────────────────────────────────────────────────
# Local development uses the CLI's fixed keys, printed by `supabase status`. They
# are identical on every machine and grant nothing against a hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Either key generation works. New projects issue publishable/secret keys, which
# rotate independently; older ones issue anon/service_role JWTs. The publishable
# key wins if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Reminder email ──────────────────────────────────────────────────────────
# Set on the Edge Function, not in this file:
#   supabase secrets set SMTP_HOST=… SMTP_PORT=… …
#
# Locally, the stack's own Mailpit accepts everything and nothing leaves the
# machine — inbox at http://127.0.0.1:54324.
#   SMTP_HOST=host.docker.internal  SMTP_PORT=54325  SMTP_TLS=false
#
# For Gmail, SMTP_PASSWORD must be an App Password, which requires 2-Step
# Verification on the sending account. An ordinary account password will not work.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=G-CME <no-reply@gapura.example>

# REQUIRED in every non-production environment. Redirects every reminder to one
# inbox, so a demo against real seeded data cannot email people who are not
# expecting it. Leave empty ONLY in production.
REMINDER_RECIPIENT_OVERRIDE=

# ─── Google Sheets mirror ────────────────────────────────────────────────────
# One-way, Supabase → Sheets, written by a Google service account.
#
# 1. Create a service account in Google Cloud and enable the Sheets API.
# 2. Create a JSON key; take `client_email` and `private_key` from it.
# 3. Share the target spreadsheet with that client_email as an Editor.
#
# The private key is multi-line: keep the \n escapes and wrap it in quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
# The id from the sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Shared secret the daily pg_cron job presents to /api/sheets/sync. Generate with
# `openssl rand -hex 32`. An unset value makes the endpoint refuse every request
# rather than run unauthenticated.
#
# The database side needs the same value, plus the app's public URL, in Supabase Vault:
#   select vault.create_secret('https://your-app.vercel.app', 'app_base_url');
#   select vault.create_secret('<the same secret>', 'sheets_sync_secret');
SHEETS_SYNC_SECRET=

# ─── Deployment tooling ──────────────────────────────────────────────────────
# Personal access token from supabase.com/dashboard/account/tokens. Used by
# `pnpm deploy:db` and the Supabase CLI. Never needed by the running app.
SUPABASE_ACCESS_TOKEN=
