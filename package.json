{
  "name": "g-cme",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT:-8443}",
    "build": "next build",
    "start": "next start --port ${PORT:-8443}",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "test": "pnpm test:rls && pnpm test:e2e",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
